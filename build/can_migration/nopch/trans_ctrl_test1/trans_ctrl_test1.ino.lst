000030d8 <SaveData::sendCommon(bool)>:
inline void identifyCommon() {
  Serial.print("LOG,1,IDENTIFY,"); Serial.print(SDLOG_FIRMWARE_ID); Serial.print(',');
  Serial.println(sizeof(Record)==152 ? "TCBIN3" : "TCBIN2");
