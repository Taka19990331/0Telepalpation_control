inline void sort(Vertex *v) {
  for(int i=1;i<3;++i) for(int j=i;j>0 && v[j].f<v[j-1].f;--j) {
    Vertex t=v[j]; v[j]=v[j-1]; v[j-1]=t;
  }
}
